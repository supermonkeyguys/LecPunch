# Copy to lan-meet/.env. Never commit the real file.
# All host ports are bound to this one private LAN address, never 0.0.0.0.
LAN_BIND_IP=192.168.1.50
LAN_ALLOWED_CIDR=192.168.1.0/24
HTTPS_PORT=8443
JVB_PORT=10000
# Required by the upstream compose parser. LAN override resets its 8000 mapping,
# so this value never creates an externally reachable HTTP port.
HTTP_PORT=8000
PUBLIC_URL=https://192.168.1.50:8443

# Pinned upstream release; upgrade only as a reviewed maintenance task.
JITSI_RELEASE_TAG=stable-11146
JITSI_IMAGE_VERSION=stable-11146
JITSI_IMAGE_REPO=ghcr.io/jitsi

# Paths are created by Initialize-LanMeet.ps1. Use forward slashes on Windows.
CONFIG=C:/replace/with/absolute/path/lan-meet/.runtime/config
TLS_CERT_PATH=C:/replace/with/absolute/path/lan-meet/certs/meet.crt
TLS_KEY_PATH=C:/replace/with/absolute/path/lan-meet/certs/meet.key

TZ=Asia/Shanghai
RESTART_POLICY=unless-stopped

# Jitsi-only credentials. They must never equal LecPunch AUTH_SECRET.
MEET_JWT_APP_ID=lecpunch-lan-meet
MEET_JWT_SECRET=REPLACE_WITH_A_NEW_64_CHAR_RANDOM_SECRET
JICOFO_COMPONENT_SECRET=REPLACE_WITH_RANDOM_VALUE
JICOFO_AUTH_PASSWORD=REPLACE_WITH_RANDOM_VALUE
JVB_AUTH_PASSWORD=REPLACE_WITH_RANDOM_VALUE
JIGASI_XMPP_PASSWORD=REPLACE_WITH_RANDOM_VALUE
JIBRI_RECORDER_PASSWORD=REPLACE_WITH_RANDOM_VALUE
JIBRI_XMPP_PASSWORD=REPLACE_WITH_RANDOM_VALUE
JIGASI_TRANSCRIBER_PASSWORD=REPLACE_WITH_RANDOM_VALUE
