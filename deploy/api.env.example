# Copy to deploy/api.env on the server before running docker compose.
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://lecpunch:change-this-mongo-password@mongo:27017/lecpunch?authSource=admin

# Replace with a long random secret before exposing the app to anyone else.
AUTH_SECRET=replace-with-a-long-random-secret

# LAN Jitsi admission only. Must be a distinct, high-entropy secret shared
# directly with the current captain machine's lan-meet/.env; never reuse
# AUTH_SECRET and never put the real value in source control.
MEET_JWT_APP_ID=lecpunch-lan-meet
MEET_JWT_SECRET=replace-with-the-captain-machine-meeting-secret
DEFAULT_TEAM_NAME=FocusTeam

# Keep registration open for the first small-scale test only if you need self-service sign-up.
ALLOW_OPEN_REGISTRATION=true

# Production-safe default: browser check-in is limited to loopback until an
# administrator replaces this with the LAN/VPN egress IP or CIDR below.
ALLOW_ANY_NETWORK=false
ALLOWED_PUBLIC_IPS=127.0.0.1
ALLOWED_CIDRS=

# The API sits behind nginx in Docker, so trust a single proxy hop.
TRUST_PROXY=true
TRUSTED_PROXY_HOPS=1
